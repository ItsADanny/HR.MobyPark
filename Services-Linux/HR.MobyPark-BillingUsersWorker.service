[Unit]
Description=HR.MobyPark Billing Users Worker

[Service]
# will set the Current Working Directory (CWD)
WorkingDirectory=/home/ubuntu-1091749/actions-runner/MobyPark_Work/HR.MobyPark/HR.MobyPark/opt/mobypark/deployment
# systemd will run this executable to start the service
ExecStart=/home/ubuntu-1091749/actions-runner/MobyPark_Work/HR.MobyPark/HR.MobyPark/opt/mobypark/deployment/HR.MobyPark-BillingUsersWorker
# to query logs using journalctl, set a logical name here  
SyslogIdentifier=MobyParkBillingUsersWorker

# Use your username to keep things simple, for production scenario's I recommend a dedicated user/group.
# If you pick a different user, make sure dotnet and all permissions are set correctly to run the app.
# To update permissions, use 'chown ubuntu-1091749 -R /home/ubuntu-1091749/actions-runner/MobyPark_Work/HR.MobyPark/HR.MobyPark/opt/mobypark/deployment/HR.MobyPark-BillingUsersWorker' to take ownership of the folder and files,
#       Use 'chmod +x /home/ubuntu-1091749/actions-runner/MobyPark_Work/HR.MobyPark/HR.MobyPark/opt/mobypark/deployment/HR.MobyPark-BillingUsersWorker' to allow execution of the executable file.
User=ubuntu-1091749

# ensure the service restarts after crashing
Restart=always
# amount of time to wait before restarting the service              
RestartSec=5

# copied from dotnet documentation at
# https://docs.microsoft.com/en-us/aspnet/core/host-and-deploy/linux-nginx
KillSignal=SIGINT
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_PRINT_TELEMETRY_MESSAGE=false

[Install]
WantedBy=multi-user.target